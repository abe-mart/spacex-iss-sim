{
  "name": "dock-the-capsule",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && python -m unittest discover -s tests -p test_event_bridge.py && python -m unittest discover -s tests -p test_controls_demo.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.81.0",
    "@neondatabase/serverless": "^1.0.0",
    "@netlify/functions": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
